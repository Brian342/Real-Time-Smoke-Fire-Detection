ype":"code","source":"# filling the object columns using mode\ndef fill_objects(df: pd.DataFrame)-> pd.DataFrame:\n    objects = df.select_dtypes(include='object')\n\n    for res in objects:\n        # calculate the most frequent using mode function\n        most_frequent = df[res].mode()[0]\n        df[res] = df[res].fillna(most_frequent)\n    return df\n\n\n# run the function \nfill_objects(combined_dataset)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# # manipulating the timestamp on the dataset\ncombined_dataset['Year'] = combined_dataset['UTC'].dt.year\ncombined_dataset['Month'] = combined_dataset['UTC'].dt.month\ncombined_dataset['Date'] = combined_dataset['UTC'].dt.day\ncombined_dataset['Hour'] = combined_dataset['UTC'].dt.hour\ncombined_dataset['Minutes'] = combined_dataset['UTC'].dt.minute\ncombined_dataset['Seconds'] = combined_dataset['UTC'].dt.second","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"combined_dataset","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# check for outliners on the data \ndef check_outliners(df: pd.DataFrame)-> pd.DataFrame:\n    \"\"\"This function is used to check for outliners on the dataset and \n    return values that are below the quantile range\n    \n    Parameters: used are df for the dataset and the function \n    1.5 threshold is somewhat arbitrary but works well \n    in practice to flag unusual points without being too sensitive.\n    \n    returns: outliner dataframe\n    \"\"\"\n    outliners_data = []\n    for columns in df.select_dtypes(include=['int', 'float']).columns:\n        upper_quantile = df[columns].quantile(.25)\n        lower_quantile = df[columns].quantile(.75)\n        IQR = lower_quantile - upper_quantile\n\n        # compute the Outliner Boundary\n        lowerBoundary = upper_quantile - 1.5 * IQR\n        upperBoundary = lower_quantile + 1.5 * IQR\n\n\n        # count the OutLiners on the dataset\n        outliners = df[(df[columns] < lowerBoundary) | (df[columns]> upperBoundary)]\n        outliner_count = outliners.shape[0]\n        outliner_per = (outliner_count / df.shape[0]) * 100\n\n\n        # append Data to the list\n        outliners_data.append({\n            \"Columns\": columns,\n            \"Outliners Count\":outliner_count,\n            \"Outliners Percentage\": outliner_per,\n            \"Lower Boundary\": lowerBoundary,\n            \"Upper Boundary\": upperBoundary\n        })\n        return outliners_data","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"check_outliners(combined_dataset)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"combined_dataset","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}